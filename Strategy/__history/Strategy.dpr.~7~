program Strategy;

{$APPTYPE CONSOLE}

uses
  SysUtils,
  WeaponBase in 'WeaponBase.pas',
  Sword in 'Sword.pas',
  Spear in 'Spear.pas',
  SlashBehavior in 'SlashBehavior.pas',
  StabBehavior in 'StabBehavior.pas',
  SpinAttackBehavior in 'SpinAttackBehavior.pas',
  PiercingThrustBehavior in 'PiercingThrustBehavior.pas';

procedure ShowWeaponMenu;
begin
  WriteLn;
  WriteLn('===== SELECT WEAPON =====');
  WriteLn('1. Sword');
  WriteLn('2. Spear');
  WriteLn('0. Exit');
  Write('Choice: ');
end;

procedure ShowActionMenu;
begin
  WriteLn;
  WriteLn('===== ACTION MENU =====');
  WriteLn('1. Attack');
  WriteLn('2. Change Attack Behavior');
  WriteLn('3. Change Weapon');
  WriteLn('0. Exit');
  Write('Choice: ');
end;

procedure ShowBehaviorMenu(Weapon: TWeapon);
begin
  WriteLn;
  WriteLn('===== ATTACK BEHAVIORS =====');
  if Weapon is TSword then
  begin
    WriteLn('1. Slash');
    WriteLn('2. Stab');
    WriteLn('3. Spin Attack');
  end
  else if Weapon is TSpear then
  begin
    WriteLn('1. Stab');
    WriteLn('2. Piercing Thrust');
  end;
  Write('Choice: ');
end;

var
  Weapon: TWeapon;
  Choice: Integer;
  Input: string;
  Running: Boolean;

begin
  Weapon := nil;
  Running := True;

  WriteLn('=== STRATEGY PATTERN: INTERACTIVE WEAPON SYSTEM ===');

  while Running do
  begin
    if Weapon = nil then
    begin
      ShowWeaponMenu;
      ReadLn(Input);

      if not TryStrToInt(Input, Choice) then
        Choice := -1;

      case Choice of
        1: Weapon := TSword.Create(TSlashBehavior.Create);
        2: Weapon := TSpear.Create(TStabBehavior.Create);
        0: Running := False;
      else
        WriteLn('Invalid choice!');
      end;

      if Weapon <> nil then
        WriteLn('Weapon selected: ', Weapon.GetName);
    end
    else
    begin
      ShowActionMenu;
      ReadLn(Input);

      if not TryStrToInt(Input, Choice) then
        Choice := -1;

      case Choice of
        1: // Attack
          Weapon.PerformAttack;

        2: // Change behavior
        begin
          ShowBehaviorMenu(Weapon);
          ReadLn(Input);
          if not TryStrToInt(Input, Choice) then Choice := -1;

          if Weapon is TSword then
          begin
            case Choice of
              1: Weapon.SetAttackBehavior(TSlashBehavior.Create);
              2: Weapon.SetAttackBehavior(TStabBehavior.Create);
              3: Weapon.SetAttackBehavior(TSpinAttackBehavior.Create);
            else
              WriteLn('Invalid behavior for Sword!');
            end;
          end
          else if Weapon is TSpear then
          begin
            case Choice of
              1: Weapon.SetAttackBehavior(TStabBehavior.Create);
              2: Weapon.SetAttackBehavior(TPiercingThrustBehavior.Create);
            else
              WriteLn('Invalid behavior for Spear!');
            end;
          end;
        end;

        3: // Change weapon
        begin
          Weapon.Free;
          Weapon := nil;
        end;

        0: Running := False;
      else
        WriteLn('Invalid option!');
      end;
    end;
  end;

  if Assigned(Weapon) then
    Weapon.Free;

  WriteLn;
  WriteLn('Exiting... May your strikes be true!');
  ReadLn;
end.

