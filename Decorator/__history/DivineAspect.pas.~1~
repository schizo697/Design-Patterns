unit DivineAspect;

interface

uses
  WeaponDecorator, WeaponIntf;

type
  TDivineAspect = class(TWeaponDecorator)
  public
    function GetDamage: Integer; override;
    function GetDescription: string; override;
    procedure Display; override;
  end;

implementation

{ TDivineAspect }

procedure TDivineAspect.Display;
begin
  Writeln('Weapon ', GetDescription);
  Writeln('Damage ', GetDamage, '[ with divine damage]');
end;

function TDivineAspect.GetDamage: Integer;
begin
  Result := FWeapon.GetDamage + 5;
end;

function TDivineAspect.GetDescription: string;
begin
  Result := Fweapon.GetDescription + ' + Divine Aspect';
end;

end.
