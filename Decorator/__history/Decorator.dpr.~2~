program Decorator;

{$APPTYPE CONSOLE}

uses
  SysUtils,
  WeaponIntf in 'WeaponIntf.pas',
  Sword in 'Sword.pas',
  Spear in 'Spear.pas',
  WeaponDecorator in 'WeaponDecorator.pas',
  FireAspect in 'FireAspect.pas',
  CurseAspect in 'CurseAspect.pas',
  DivineAspect in 'DivineAspect.pas';

var
  Weapon: IWeapon;
  Choice: Integer;

procedure ShowMenu;
begin
  Writeln;
  Writeln('=== Weapon Decorator Menu ===');
  Writeln('1. Select Sword');
  Writeln('2. Select Spear');
  Writeln('3. Add Fire Aspect');
  Writeln('4. Add Curse Aspect');
  Writeln('5. Add Divine Aspect');
  Writeln('6. Display Weapon Info');
  Writeln('7. Exit');
  Write('Choose: ');
end;

begin
  Randomize;
  Weapon := nil;

  repeat
    ShowMenu;
    Readln(Choice);

    case Choice of
      1: Weapon := TSword.Create;
      2: Weapon := TSpear.Create;
      3:
        if Assigned(Weapon) then
          Weapon := TFireAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      4:
        if Assigned(Weapon) then
          Weapon := TCurseAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      5:
        if Assigned(Weapon) then
          Weapon := TDivineAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      6:
        if Assigned(Weapon) then
          Weapon.Display
        else
          Writeln('Select a weapon first!');
    end;

  until Choice = 7;
end.

