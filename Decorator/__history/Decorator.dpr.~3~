program Decorator;

{$APPTYPE CONSOLE}

uses
  SysUtils,
  WeaponIntf in 'WeaponIntf.pas',
  Sword in 'Sword.pas',
  Spear in 'Spear.pas',
  WeaponDecorator in 'WeaponDecorator.pas',
  FireAspect in 'FireAspect.pas',
  CurseAspect in 'CurseAspect.pas',
  DivineAspect in 'DivineAspect.pas';

var
  Weapon: IWeapon;
  Choice: Integer;
  WeaponConfirmed: Boolean;

procedure ShowWeaponMenu;
begin
  Writeln;
  Writeln('=== Select Weapon ===');
  Writeln('1. Sword');
  Writeln('2. Spear');
  Writeln('3. Cancel / Back');
  Write('Choose: ');
end;

procedure ShowDecoratorMenu;
begin
  Writeln;
  Writeln('=== Weapon Decorator Menu ===');
  Writeln('1. Add Fire Aspect');
  Writeln('2. Add Curse Aspect');
  Writeln('3. Add Divine Aspect');
  Writeln('4. Display Weapon Info');
  Writeln('5. Change Weapon');
  Writeln('6. Exit');
  Write('Choose: ');
end;

begin
  Randomize;
  Weapon := nil;
  WeaponConfirmed := False;

  // Initial weapon selection loop
  repeat
    ShowWeaponMenu;
    Readln(Choice);

    case Choice of
      1: Weapon := TSword.Create;
      2: Weapon := TSpear.Create;
      3: Weapon := nil;
    end;

    if Assigned(Weapon) then
    begin
      Writeln;
      Writeln('You selected:');
      Weapon.Display;

      Writeln('Confirm this weapon? (Y/N)');
      var Confirm: string;
      Readln(Confirm);
      if (UpperCase(Confirm) = 'Y') then
        WeaponConfirmed := True
      else
        Weapon := nil; // reset to select again
    end;

  until WeaponConfirmed;

  // Decorator menu loop
  repeat
    ShowDecoratorMenu;
    Readln(Choice);

    case Choice of
      1:
        if Assigned(Weapon) then
          Weapon := TFireAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      2:
        if Assigned(Weapon) then
          Weapon := TCurseAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      3:
        if Assigned(Weapon) then
          Weapon := TDivineAspect.Create(Weapon)
        else
          Writeln('Select a weapon first!');
      4:
        if Assigned(Weapon) then
          Weapon.Display
        else
          Writeln('Select a weapon first!');
      5:
        begin
          Weapon := nil;
          WeaponConfirmed := False;

          // Go back to weapon selection
          repeat
            ShowWeaponMenu;
            Readln(Choice);

            case Choice of
              1: Weapon := TSword.Create;
              2: Weapon := TSpear.Create;
              3: Weapon := nil;
            end;

            if Assigned(Weapon) then
            begin
              Writeln;
              Writeln('You selected:');
              Weapon.Display;

              Writeln('Confirm this weapon? (Y/N)');
              var Confirm: string;
              Readln(Confirm);
              if (UpperCase(Confirm) = 'Y') then
                WeaponConfirmed := True
              else
                Weapon := nil;
            end;

          until WeaponConfirmed;
        end;
    end;

  until Choice = 6;

end.

