program Adapter;

{$APPTYPE CONSOLE}

{$R *.res}

uses
  System.SysUtils,
  EUChargerIntf in 'EUChargerIntf.pas',
  UKOutlet in 'UKOutlet.pas',
  UKToEUAdapter in 'UKToEUAdapter.pas',
  Laptop in 'Laptop.pas';


var
  Laptop: TLaptop;
  UKOutlet: TUKOutlet;
  Adapter: IEUCharger;
begin
  Laptop := TLaptop.Create;
  UKOutlet := TUKOutlet.Create;

  Adapter := TUKToEUAdapter.Create(UKOutlet);

  Laptop.Charge(Adapter);

  Readln;
end.

