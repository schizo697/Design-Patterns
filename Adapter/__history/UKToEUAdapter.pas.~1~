unit UKToEUAdapter;

interface

uses
  EUChargerIntf, UKOutlet;

type
  TUKToEUAdapter = class(TInterfacedObject, IEUCharger)
  private
    FUKOutlet: TUKOutlet;
  public
    constructor Create(AOutlet: TUKOutlet);
    procedure PlugIntoEUSocket;
  end;

implementation

constructor TUKToEUAdapter.Create(AOutlet: TUKOutlet);
begin
  FUKOutlet := AOutlet;
end;

procedure TUKToEUAdapter.PlugIntoEUSocket;
begin
  Writeln('Adapter converting 2 round pins → 3 flat pins');
  FUKOutlet.PlugIntoUKSocket;
end;

end.

